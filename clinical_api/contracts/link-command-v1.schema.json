{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:stroke-platform:contracts:link-command:v1",
  "title": "Explicit operator-approved identity link command",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "issuer",
    "subject",
    "role",
    "personId"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "issuer": {
      "const": "urn:stroke-platform:identity:v1"
    },
    "subject": {
      "type": "string",
      "pattern": "^[a-f0-9]{24}$"
    },
    "role": {
      "type": "string",
      "enum": [
        "patient",
        "doctor",
        "technician"
      ]
    },
    "personId": {
      "type": "string",
      "format": "uuid"
    }
  }
}
