{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:stroke-platform:contracts:clinical-workspace:v1",
  "title": "Live approved-patient or assigned-staff discovery",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sourceId",
    "limit",
    "encounters"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "sourceId": {
      "type": "string",
      "format": "uuid"
    },
    "limit": {
      "const": 100
    },
    "encounters": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "encounterId",
          "patientId",
          "mode",
          "appointmentId",
          "state",
          "version"
        ],
        "properties": {
          "encounterId": {
            "type": "string",
            "format": "uuid"
          },
          "patientId": {
            "type": "string",
            "format": "uuid"
          },
          "mode": {
            "enum": [
              "SCHEDULED",
              "EMERGENCY"
            ]
          },
          "appointmentId": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          },
          "state": {
            "enum": [
              "DRAFT",
              "SUBMITTED",
              "APPROVED",
              "REJECTED"
            ]
          },
          "version": {
            "type": "integer",
            "minimum": 0,
            "maximum": 128
          }
        }
      }
    }
  }
}
