{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:stroke-platform:contracts:assessment-receipt:v1",
  "title": "Immutable SQLite creation/rejection receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "mode",
    "requestId",
    "appointmentId",
    "encounterId",
    "sourceId",
    "patientId",
    "clinicianMappingId",
    "state",
    "errorCode"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "mode": {
      "enum": [
        "SCHEDULED",
        "EMERGENCY"
      ]
    },
    "requestId": {
      "type": "string",
      "format": "uuid"
    },
    "appointmentId": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "encounterId": {
      "type": "string",
      "format": "uuid"
    },
    "sourceId": {
      "type": "string",
      "format": "uuid"
    },
    "patientId": {
      "type": "string",
      "format": "uuid"
    },
    "clinicianMappingId": {
      "type": "string",
      "format": "uuid"
    },
    "state": {
      "enum": [
        "CREATED",
        "REJECTED"
      ]
    },
    "errorCode": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
