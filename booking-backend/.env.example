# Generate separate private values; never commit real keys or tokens.
JWT_SECRET=
# 32 random bytes encoded as 64 hex characters; protects local delivery envelopes.
IDENTITY_DELIVERY_KEY=
# Server enforced range: 60-900 seconds. No refresh tokens.
JWT_TTL_SECONDS=900
MONGODB_URI=mongodb://127.0.0.1:27017/hospital-booking?replicaSet=rs0
PORT=3000
# Only for an explicitly authorized first-admin CLI operation; never the web process.
ALLOW_IDENTITY_BOOTSTRAP=false
