{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:stroke-platform:contracts:assessment-intent:v1",
  "title": "Idempotent scheduled assessment intent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "sourceId",
    "patientId",
    "patientMappingId",
    "clinicianMappingId"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "requestId": {
      "type": "string",
      "format": "uuid"
    },
    "sourceId": {
      "type": "string",
      "format": "uuid"
    },
    "patientId": {
      "type": "string",
      "format": "uuid"
    },
    "patientMappingId": {
      "type": "string",
      "format": "uuid"
    },
    "clinicianMappingId": {
      "type": "string",
      "format": "uuid"
    }
  }
}
