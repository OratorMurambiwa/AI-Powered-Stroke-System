{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:stroke-platform:contracts:appointment-proof:v1",
  "title": "Live authority reservation proof; online validation mandatory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "issuer",
    "appointmentId",
    "requestId",
    "encounterId",
    "commandHash",
    "patientSubject",
    "patientRoleVersion",
    "doctorSubject",
    "doctorRoleVersion",
    "actorSubject",
    "actorRoleVersion",
    "sessionId",
    "status",
    "expiresAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "issuer": {
      "const": "urn:stroke-platform:identity:v1"
    },
    "appointmentId": {
      "type": "string",
      "format": "uuid"
    },
    "requestId": {
      "type": "string",
      "format": "uuid"
    },
    "encounterId": {
      "type": "string",
      "format": "uuid"
    },
    "commandHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "patientSubject": {
      "type": "string",
      "pattern": "^[a-f0-9]{24}$"
    },
    "patientRoleVersion": {
      "type": "integer",
      "minimum": 0
    },
    "doctorSubject": {
      "type": "string",
      "pattern": "^[a-f0-9]{24}$"
    },
    "doctorRoleVersion": {
      "type": "integer",
      "minimum": 0
    },
    "actorSubject": {
      "type": "string",
      "pattern": "^[a-f0-9]{24}$"
    },
    "actorRoleVersion": {
      "type": "integer",
      "minimum": 0
    },
    "sessionId": {
      "type": "string",
      "format": "uuid"
    },
    "status": {
      "const": "RESERVED"
    },
    "expiresAt": {
      "type": "integer",
      "minimum": 0
    }
  }
}
